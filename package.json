{
  "name": "ui-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Chrome UI review annotations with agent-ready handoff",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build --config vite.content.config.ts && vite build --config vite.bridge.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "bridge:install": "node scripts/install-bridge-host.mjs install",
    "bridge:uninstall": "node scripts/install-bridge-host.mjs uninstall",
    "bridge:package": "node scripts/package-bridge.mjs",
    "bridge:smoke": "node scripts/bridge-smoke.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
