{
  "manifest_version": 3,
  "name": "UI Review",
  "version": "0.1.0",
  "description": "Local-first UI review annotations with agent-ready handoff.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "tabs", "nativeMessaging", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "UI Review — open side panel"
  }
}
